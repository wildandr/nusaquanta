# Postgres connection string (Neon: pakai versi "pooled" untuk runtime)
DATABASE_URL=

# Secret Payload (32+ karakter random, jangan pernah commit)
PAYLOAD_SECRET=

# URL publik site (untuk admin panel, live URL saat deploy)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Otomatis ter-set di Vercel saat Blob storage di-attach (jangan isi manual)
BLOB_READ_WRITE_TOKEN=
